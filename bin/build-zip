#!/bin/sh
# Genera dist/meta-descriptions-ia-{versión}.zip listo para instalar. Todo en Docker.
set -e
cd "$(dirname "$0")/.."
VERSION=$(sed -n 's/^ \* Version: *//p' plugin/meta-descriptions-ia.php | tr -d '[:space:]')

docker compose run --rm php composer install --no-dev --optimize-autoloader --no-interaction --quiet
if [ -d plugin/node_modules ]; then
	docker compose run --rm node npm run build --silent
else
	docker compose run --rm node sh -c "npm ci --no-fund --no-audit --silent && npm run build --silent"
fi

rm -rf dist && mkdir -p dist
docker compose run --rm -v "$PWD/dist:/dist" php sh -c "
	rm -rf /tmp/pkg && mkdir -p /tmp/pkg/meta-descriptions-ia &&
	cp -r meta-descriptions-ia.php uninstall.php readme.txt LICENSE src vendor build languages /tmp/pkg/meta-descriptions-ia/ &&
	cd /tmp/pkg && zip -qr /dist/meta-descriptions-ia-$VERSION.zip meta-descriptions-ia"

# Deja el entorno de desarrollo como estaba (PHPUnit y demás).
docker compose run --rm php composer install --no-interaction --quiet
echo "Creado dist/meta-descriptions-ia-$VERSION.zip"
