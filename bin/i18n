#!/bin/sh
# Regenera los archivos de idioma. Tras añadir cadenas, traduce las nuevas en
# plugin/languages/geo-tool-es_ES.po y vuelve a ejecutar este script.
cd "$(dirname "$0")/.." || exit 1
PD=wp-content/plugins/geo-tool
wp() { docker compose run --rm -T wpcli "$@"; }
wp i18n make-pot "$PD" "$PD/languages/geo-tool.pot" --exclude=vendor,node_modules,tests,build --domain=geo-tool &&
wp i18n update-po "$PD/languages/geo-tool.pot" "$PD/languages" &&
wp i18n make-mo "$PD/languages" &&
wp i18n make-json "$PD/languages" --no-purge &&
wp eval-file "$PD/tests/tools/merge-script-translations.php"
