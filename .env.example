# Copia este archivo a .env y ajusta los valores (solo entorno local).
WP_PORT=8787
MAILPIT_PORT=8797
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=cambia-esto
WP_ADMIN_EMAIL=admin@example.test
# Región de Amazon Bedrock para las pruebas locales (opcional).
AWS_BEDROCK_REGION=eu-west-1
# Clave de API de Amazon Bedrock para las pruebas locales (opcional). Nunca la subas a git.
AWS_BEDROCK_API_KEY=
