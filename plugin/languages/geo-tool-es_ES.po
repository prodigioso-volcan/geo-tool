#: src/Checks/Detail.php:26
#, php-format
msgid "robots.txt keeps these AI crawlers out: %s."
msgstr "El archivo robots.txt impide el paso a estos rastreadores de IA: %s."

#: src/Checks/Detail.php:30
msgid "It is empty."
msgstr "Está vacío."

#: src/Checks/Detail.php:31
msgid "It is too short to be useful."
msgstr "Es demasiado corto para ser útil."

#: src/Checks/Detail.php:32
msgid "It is too long: search engines will cut it."
msgstr "Es demasiado largo: los buscadores lo cortarán."

#: src/Checks/Detail.php:33
msgid "It only repeats the title of the page."
msgstr "Solo repite el título de la página."

#: src/Checks/Detail.php:34
msgid "Another page has exactly the same text."
msgstr "Otra página tiene exactamente el mismo texto."

#: src/Checks/Detail.php:35
msgid "The description exists, but the one shown in search results is empty."
msgstr "La descripción existe, pero la que se muestra en los resultados de búsqueda está vacía."

#: src/Checks/Detail.php:36
msgid "This published page asks search engines not to show it."
msgstr "Esta página publicada pide a los buscadores que no la muestren."

#: src/Checks/Detail.php:39
msgid "It still has the sample content WordPress ships with."
msgstr "Conserva el contenido de ejemplo que trae WordPress."

#: src/Checks/Detail.php:40
msgid "It contains filler text (lorem ipsum or similar)."
msgstr "Contiene texto de relleno (lorem ipsum o parecido)."

#: src/Checks/Detail.php:41
msgid "The content has more than one H1."
msgstr "El contenido tiene más de un H1."

#: src/Checks/Detail.php:43
msgid "A heading level is skipped (an H2 followed by an H4, for instance)."
msgstr "Se salta un nivel de encabezado (por ejemplo, un H2 seguido de un H4)."

#: src/Checks/Detail.php:44
msgid "robots.txt keeps every crawler out of the whole site."
msgstr "El archivo robots.txt impide el paso de todos los rastreadores a todo el sitio."

#: src/Checks/Detail.php:45
msgid "This is not in place yet."
msgstr "Todavía no está configurado."

#: src/Checks/Finding_Actions.php:28
msgid "This check is not fixed by writing a text here."
msgstr "Esta comprobación no se corrige escribiendo un texto aquí."

#: src/Checks/Finding_Actions.php:40
msgid "The text cannot be empty."
msgstr "El texto no puede estar vacío."

#: src/Checks/Finding_Actions.php:62
msgid "The text could not be saved."
msgstr "No se ha podido guardar el texto."

#: src/Checks/Finding_Actions.php:207
msgid "A new proposal cannot be requested for this item in its current state."
msgstr "No se puede pedir una nueva propuesta para este elemento en su estado actual."

#: src/Checks/Finding_Actions.php:301
msgid "There is no applied change to undo here."
msgstr "Aquí no hay ningún cambio aplicado que deshacer."

#: src/Checks/Finding_Actions.php:344
msgid "Unknown field."
msgstr "Campo desconocido."

#: src/Checks/Finding_Actions.php:372
msgid "This item no longer exists."
msgstr "Este elemento ya no existe."

#: src/Checks/Finding_Actions.php:378
msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

#: src/Checks/Post/Acf_Empty.php:24
msgid "Custom field left empty"
msgstr "Campo personalizado vacío"

#: src/Checks/Post/Acf_Empty.php:28
msgid "A content field nobody filled in usually means a blank spot on the page."
msgstr "Un campo de contenido que nadie ha rellenado suele ser un hueco en blanco en la página."

#: src/Checks/Post/Excerpt.php:17
msgid "Excerpt"
msgstr "Extracto"

#: src/Checks/Post/Excerpt.php:21
msgid "Listings, feeds and shared links use the excerpt. Without one, WordPress cuts the first lines of the text."
msgstr "Los listados, los feeds y los enlaces compartidos usan el extracto. Si no lo hay, WordPress corta las primeras líneas del texto."

#: src/Checks/Post/Featured_Image.php:17
msgid "Featured image"
msgstr "Imagen destacada"

#: src/Checks/Post/Featured_Image.php:21
msgid "It is the image shown when the page is shared and in listings."
msgstr "Es la imagen que se muestra al compartir la página y en los listados."

#: src/Checks/Post/Headings.php:20
msgid "Heading structure"
msgstr "Estructura de encabezados"

#: src/Checks/Post/Headings.php:24
msgid "Screen readers, search engines and AI assistants read headings as the outline of the page. More than one H1 or a skipped level breaks it."
msgstr "Los lectores de pantalla, los buscadores y los asistentes de IA leen los encabezados como el esquema de la página. Más de un H1 o un nivel saltado lo rompen."

#: src/Checks/Post/Metadesc.php:29
msgid "Meta description"
msgstr "Metadescripción"

#: src/Checks/Post/Metadesc.php:33
msgid "It is the summary search engines and AI assistants show for the page. Without it they make one up."
msgstr "Es el resumen de la página que muestran los buscadores y los asistentes de IA. Si falta, se lo inventan."

#: src/Checks/Post/Noindex.php:19
msgid "Page hidden from search engines"
msgstr "Página oculta a los buscadores"

#: src/Checks/Post/Noindex.php:23
msgid "A page marked as \"noindex\" never shows up in search results or AI answers. Confirm it is on purpose."
msgstr "Una página marcada como «noindex» no aparece nunca en los resultados de búsqueda ni en las respuestas de la IA. Confirma que es a propósito."

#: src/Checks/Post/Placeholder_Content.php:24
msgid "Leftover template content"
msgstr "Restos de plantilla"

#: src/Checks/Post/Seo_Title.php:24
msgid "Title shown in search results"
msgstr "Título en los resultados de búsqueda"

#: src/Checks/Post/Seo_Title.php:28
msgid "Search engines cut titles longer than about 60 characters, and two pages with the same title compete with each other."
msgstr "Los buscadores cortan los títulos de más de unos 60 caracteres, y dos páginas con el mismo título compiten entre sí."

#: src/Checks/Registry.php:31
msgid "Author biography"
msgstr "Biografía del autor"

#: src/Checks/Registry.php:32
msgid "Search engines and AI assistants weigh who wrote a text. An author with no biography is an unknown."
msgstr "Los buscadores y los asistentes de IA valoran quién ha escrito un texto. Un autor sin biografía es un desconocido."

#: src/Checks/Registry.php:37
msgid "Author public name"
msgstr "Nombre público del autor"

#: src/Checks/Registry.php:38
msgid "The name shown on articles should be a real name, not the login name."
msgstr "El nombre que aparece en los artículos debe ser un nombre real, no el nombre de usuario."

#: src/Checks/Site/Catalogue.php:45
msgid "SEO plugin"
msgstr "Plugin de SEO"

#: src/Checks/Site/Catalogue.php:53
msgid "Visible to search engines"
msgstr "Visible para los buscadores"

#: src/Checks/Site/Catalogue.php:54
msgid "While \"Discourage search engines\" is ticked, the whole site asks not to be indexed."
msgstr "Mientras esté marcada la casilla «Pedir a los motores de búsqueda que no indexen este sitio», toda la web pide no ser indexada."

#: src/Checks/Site/Catalogue.php:61
msgid "Site title and tagline"
msgstr "Título y descripción corta del sitio"

#: src/Checks/Site/Catalogue.php:62
msgid "They appear in every page title and tell search engines and AI assistants what the site is."
msgstr "Aparecen en el título de todas las páginas y dicen a los buscadores y a los asistentes de IA qué es el sitio."

#: src/Checks/Site/Catalogue.php:69
msgid "Home page meta description"
msgstr "Metadescripción de la portada"

#: src/Checks/Site/Catalogue.php:70
msgid "It is the summary of the whole site in search results."
msgstr "Es el resumen de todo el sitio en los resultados de búsqueda."

#: src/Checks/Site/Catalogue.php:78
msgid "Who is behind the site"
msgstr "Quién está detrás del sitio"

#: src/Checks/Site/Catalogue.php:79
msgid "The organisation name and logo go into the structured data that search engines and AI assistants use to identify the publisher."
msgstr "El nombre y el logotipo de la organización van en los datos estructurados con los que los buscadores y los asistentes de IA identifican a quien publica."

#: src/Checks/Site/Catalogue.php:86
msgid "XML sitemap"
msgstr "Mapa del sitio XML"

#: src/Checks/Site/Catalogue.php:87
msgid "The sitemap is how crawlers find every page."
msgstr "El mapa del sitio es la forma en que los rastreadores encuentran todas las páginas."

#: src/Checks/Site/Catalogue.php:94
msgid "robots.txt"
msgstr "robots.txt"

#: src/Checks/Site/Catalogue.php:95
msgid "A robots.txt that keeps crawlers out makes the site invisible, in search results or in AI answers."
msgstr "Un robots.txt que impide el paso a los rastreadores hace invisible el sitio, en los resultados de búsqueda o en las respuestas de la IA."

#: src/Checks/Site/Catalogue.php:114
msgid "Structured data"
msgstr "Datos estructurados"

#: src/Checks/Site/Catalogue.php:115
msgid "Structured data tells machines what each page is: an article, an organisation, who wrote it and when."
msgstr "Los datos estructurados dicen a las máquinas qué es cada página: un artículo, una organización, quién lo escribió y cuándo."

#: src/Checks/Site/Catalogue.php:122
msgid "llms.txt"
msgstr "llms.txt"

#: src/Checks/Site/Catalogue.php:123
msgid "An llms.txt file gives AI assistants a short guide to the most important pages of the site."
msgstr "Un archivo llms.txt da a los asistentes de IA una guía breve de las páginas más importantes del sitio."

#: src/Checks/Site/Catalogue.php:135
msgid "Default image for sharing"
msgstr "Imagen por defecto al compartir"

#: src/Checks/Site/Catalogue.php:136
msgid "It is the image shown when a page without its own image is shared."
msgstr "Es la imagen que se muestra al compartir una página que no tiene imagen propia."

#: src/Checks/Site/Catalogue.php:143
msgid "Permalinks"
msgstr "Enlaces permanentes"

#: src/Checks/Site/Catalogue.php:144
msgid "Addresses like \"?p=123\" say nothing about the page. Use readable ones."
msgstr "Las direcciones como «?p=123» no dicen nada de la página. Usa direcciones legibles."

#: src/Checks/Site/Catalogue.php:151
msgid "HTTPS"
msgstr "HTTPS"

#: src/Checks/Site/Catalogue.php:152
msgid "Browsers and search engines mark sites without HTTPS as not secure."
msgstr "Los navegadores y los buscadores marcan como no seguros los sitios sin HTTPS."

#: src/Checks/Site/Catalogue.php:159
msgid "Site icon"
msgstr "Icono del sitio"

#: src/Checks/Site/Catalogue.php:160
msgid "It is the icon in browser tabs, bookmarks and some search results."
msgstr "Es el icono de las pestañas del navegador, los marcadores y algunos resultados de búsqueda."

#: src/Checks/Site/Catalogue.php:167
msgid "Site name in page titles"
msgstr "Nombre del sitio en los títulos"

#: src/Checks/Site/Catalogue.php:168
msgid "The site name is added to the title of every page. Search engines cut titles longer than about 60 characters."
msgstr "El nombre del sitio se añade al título de todas las páginas. Los buscadores cortan los títulos de más de unos 60 caracteres."

#: src/Checks/Term_Description.php:25
msgid "Category or tag description"
msgstr "Descripción de categoría o etiqueta"

#: src/Checks/Term_Description.php:29
msgid "Category and tag pages are indexed too. Without a description they have no summary to show."
msgstr "Las páginas de categoría y de etiqueta también se indexan. Sin descripción no tienen resumen que mostrar."

