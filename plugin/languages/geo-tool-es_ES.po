#, js-format
msgid "%d required item left before delivery."
msgid_plural "%d required items left before delivery."
msgstr[0] "Queda %d cosa obligatoria antes de entregar."
msgstr[1] "Quedan %d cosas obligatorias antes de entregar."

#. translators: %d: number of things to fix.
#: assets/src/tabs/Dashboard.js:285
#, js-format
msgid "%d recommended item left."
msgid_plural "%d recommended items left."
msgstr[0] "%d recomendada pendiente."
msgstr[1] "%d recomendadas pendientes."

#: src/Checks/Detail.php:38
msgid "Its title looks like a test. If it is a real page, accept it as it is."
msgstr "Su título parece de prueba. Si es una página real, acéptala como está."

#: src/Checks/Finding_Actions.php:250
msgid "The trash is switched off on this site, so the page would be deleted for good. Delete it from the list of pages instead."
msgstr "Esta web tiene la papelera desactivada, así que la página se borraría para siempre. Bórrala desde el listado de páginas."

#. translators: %d: number of images.
#: assets/src/tabs/Dashboard.js:296
#, js-format
