#: assets/src/tabs/Findings.js:361
msgid "Where"
msgstr "Dónde"

#: assets/src/tabs/Findings.js:396
msgid "Check"
msgstr "Comprobación"

#: assets/src/tabs/Findings.js:441
msgid "Nothing pending here."
msgstr "Aquí no queda nada pendiente."

#: assets/src/tabs/Findings.js:442
msgid "Nothing here."
msgstr "Aquí no hay nada."

#: src/Checks/Detail.php:42
msgid "The site name is long and it is added to the title of every page, so search engines cut the titles. Take it out of the title templates of the SEO plugin, or accept it as it is."
msgstr "El nombre del sitio es largo y se añade al título de todas las páginas, así que los buscadores cortan los títulos. Quítalo de las plantillas de título del plugin de SEO o acéptalo como está."

#: src/Checks/Finding_Actions.php:35
msgid "This item has already been decided. Undo it or review it again first."
msgstr "Este elemento ya está decidido. Deshazlo o vuelve a revisarlo antes."

#: src/Checks/Finding_Actions.php:211
msgid "The AI is not allowed to read page text. An administrator can allow it in the settings."
msgstr "La IA no tiene permiso para leer el texto de las páginas. Un administrador puede permitirlo en los ajustes."

#: src/Checks/Finding_Actions.php:307
msgid "The text was changed after it was approved. Undoing would overwrite that change."
msgstr "El texto se cambió después de aprobarlo. Deshacer sobrescribiría ese cambio."

#: src/Checks/Site/Catalogue.php:46
msgid "GEO Tool fills in the fields of the SEO plugin (Yoast SEO or Rank Math), which is what publishes them. Without one, titles and descriptions cannot be checked or written."
msgstr "GEO Tool rellena los campos del plugin de SEO (Yoast SEO o Rank Math), que es quien los publica. Sin uno de ellos no se pueden comprobar ni escribir títulos y descripciones."

#: assets/src/tabs/Dashboard.js:310
msgid "No SEO plugin is active. Meta descriptions, SEO titles and most site checks need Yoast SEO or Rank Math; until one is active they are not checked."
msgstr "No hay ningún plugin de SEO activo. Las metadescripciones, los títulos SEO y casi todas las comprobaciones del sitio necesitan Yoast SEO o Rank Math; hasta que haya uno activo no se comprueban."

#: assets/src/wizard/Wizard.js:93
msgid "No SEO plugin is active. Image alt text works without one, but meta descriptions, SEO titles and most site checks need Yoast SEO or Rank Math."
msgstr "No hay ningún plugin de SEO activo. El texto alternativo de las imágenes funciona sin él, pero las metadescripciones, los títulos SEO y casi todas las comprobaciones del sitio necesitan Yoast SEO o Rank Math."

#: assets/src/wizard/Wizard.js:98
msgid "Install one (new tab)"
msgstr "Instalar uno (pestaña nueva)"

#: src/Checks/Detail.php:37
msgid "Its title says it is a test."
msgstr "Su título indica que es una prueba."

#: src/Checks/Finding_Actions.php:243
msgid "Only test pages can be deleted from here."
msgstr "Desde aquí solo se pueden eliminar páginas de prueba."

#: src/Checks/Finding_Actions.php:253
msgid "The page could not be sent to the trash."
msgstr "No se ha podido enviar la página a la papelera."

#: src/Checks/Post/Placeholder_Content.php:28
msgid "Filler text must not be public on a finished site."
msgstr "El texto de relleno no debe estar publicado en una web terminada."

#: src/Checks/Post/Test_Page.php:34
msgid "Test page to delete"
msgstr "Página de prueba para eliminar"

#: src/Checks/Post/Test_Page.php:38
msgid "Test pages and the sample content WordPress ships with must not be public on a finished site. Delete it or, if it is real content, accept it as it is."
msgstr "Las páginas de prueba y el contenido de ejemplo que trae WordPress no deben estar publicados en una web terminada. Elimínala o, si es contenido real, acéptala como está."

#: assets/src/components/FindingRow.js:14
msgid "Sent to the trash."
msgstr "Enviada a la papelera."

#. translators: %s: title of a page.
#: assets/src/components/FindingRow.js:248
#, js-format
msgid "Send \"%s\" to the trash? It stops being public. You can recover it from the trash of WordPress."
msgstr "¿Enviar «%s» a la papelera? Dejará de estar publicada. Puedes recuperarla desde la papelera de WordPress."

#: assets/src/components/FindingRow.js:259
#: assets/src/components/FindingRow.js:264
msgid "Send to the trash"
msgstr "Enviar a la papelera"

#: src/Checks/Finding_Actions.php:173
msgid "Only an item accepted as it is can be reviewed again."
msgstr "Solo se puede volver a revisar un elemento aceptado como está."

#: assets/src/tabs/Dashboard.js:266
msgid "Nothing is pending: the site is ready to deliver."
msgstr "No queda nada pendiente: la web está lista para entregar."

#. translators: %d: number of things to fix.
