#: assets/src/tabs/Review.js:243
msgid "Language"
msgstr "Idioma"

#: assets/src/components/ModelPicker.js:7
msgid "Recommended: small, cheap and reliable"
msgstr "Recomendados: pequeños, baratos y fiables"

#: assets/src/components/ModelPicker.js:8
msgid "Larger models: they work and cost more"
msgstr "Modelos más grandes: funcionan y cuestan más"

#: assets/src/components/ModelPicker.js:9
msgid "Not checked with this plugin"
msgstr "Sin comprobar con este plugin"

#: assets/src/components/ModelPicker.js:42
msgid "No connected AI provider offers a model that can describe images."
msgstr "Ningún proveedor de IA conectado ofrece un modelo que pueda describir imágenes."

#: assets/src/components/ModelPicker.js:64
msgid "Model that writes the texts"
msgstr "Modelo que escribe los textos"

#: assets/src/components/ModelPicker.js:65
msgid "Left on automatic, the plugin uses the newest small model of the connected provider. Larger models cost more per text and rarely write better alt text or meta descriptions."
msgstr "En automático, el plugin usa el modelo pequeño más reciente del proveedor conectado. Los modelos más grandes cuestan más por texto y rara vez escriben mejor un texto alternativo o una metadescripción."

#. translators: %s: name of an AI model.
#: assets/src/components/ModelPicker.js:76
#, js-format
msgid "Automatic: %s"
msgstr "Automático: %s"

#: assets/src/components/ModelPicker.js:79
msgid "Automatic"
msgstr "Automático"

#: assets/src/components/ModelPicker.js:98
msgid "The connected provider offers none of the recommended models (Claude Haiku, GPT mini, Gemini Flash). On automatic, WordPress uses the first model of its list, which may describe images badly. Choose one here and check the result."
msgstr "El proveedor conectado no ofrece ninguno de los modelos recomendados (Claude Haiku, GPT mini, Gemini Flash). En automático, WordPress usa el primer modelo de su lista, que puede describir mal las imágenes. Elige uno aquí y comprueba el resultado."

#: assets/src/components/ModelPicker.js:106
msgid "This model has not been checked with the plugin. Some small models invent what is in a picture: review a few proposals before approving many."
msgstr "Este modelo no se ha comprobado con el plugin. Algunos modelos pequeños se inventan lo que hay en la imagen: revisa unas cuantas propuestas antes de aprobar muchas."

#: assets/src/tabs/Settings.js:113
msgid "The model is saved with the \"Save settings\" button above."
msgstr "El modelo se guarda con el botón «Guardar ajustes» de arriba."

#: assets/src/wizard/Wizard.js:193
msgid "This model is not one of the recommended ones (Claude Haiku, GPT mini, Gemini Flash) and may describe images badly. Read the text above: if it does not match the picture, choose another model in Settings when you finish."
msgstr "Este modelo no es de los recomendados (Claude Haiku, GPT mini, Gemini Flash) y puede describir mal las imágenes. Lee el texto de arriba: si no corresponde con la imagen, elige otro modelo en Ajustes al terminar."
