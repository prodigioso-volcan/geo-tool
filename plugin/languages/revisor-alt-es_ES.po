#. Plugin Name of the plugin
#: revisor-alt.php
msgid "Revisor ALT by JUNGLE"
msgstr "Revisor ALT by JUNGLE"

#. Description of the plugin
#: revisor-alt.php
msgid "Audits image alt text in the media library and in published content, and proposes better alt text with AI for human review."
msgstr "Revisa el texto alternativo de las imágenes en la biblioteca de medios y en el contenido publicado, y propone con IA textos mejores para que una persona los revise."

#: revisor-alt.php:29
msgid "Revisor ALT by JUNGLE requires WordPress 7.0 or later."
msgstr "Revisor ALT by JUNGLE necesita WordPress 7.0 o superior."

