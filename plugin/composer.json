{
	"name": "prodigiosovolcan/geo-tool",
	"description": "AI-generated alt text for the WordPress media library.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": { "MDIA\\": "src/" }
	},
	"config": {
		"platform": { "php": "8.1.0" },
		"sort-packages": true
	}
}
